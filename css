
/* 1. Colour variables and global settings */
:root {
    --background: #F8F7F4;
    --paper: #FFFFFF;
    --text: #202020;
    --muted: #656565;
    --border: #DEDCD6;
    --accent: #E87535;
    --soft: #E8D2C2;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
    scroll-padding-top: 85px;
}

body {
    background: var(--background);
    color: var(--text);
    font-family: "DM Sans", sans-serif;
    line-height: 1.7;
}

h1, h2, h3, .logo {
    font-family: "Space Grotesk", sans-serif;
    line-height: 1.2;
}

a {
    color: inherit;
    text-decoration: none;
}

a:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 4px;
}

p {
    max-width: 70ch;
}

section {
    scroll-margin-top: 85px;
}

/* 2. Header and navigation */
.site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--background);
    border-bottom: 1px solid var(--border);
}

.navbar {
    max-width: 1200px;
    margin: auto;
    min-height: 76px;
    padding: 12px 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
}

.logo {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -1px;
}

.logo span,
.section-heading h2 span,
.contact-section h2 span {
    color: var(--accent);
}

.nav-links {
    display: flex;
    align-items: center;
    gap: 22px;
}

.nav-link {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--muted);
}

.nav-link:hover {
    color: var(--accent);
}

.nav-contact {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--accent);
}

/* 3. Shared layout and buttons */
.section-container {
    max-width: 1200px;
    margin: auto;
    padding-left: 32px;
    padding-right: 32px;
}

.content-section {
    padding-top: 85px;
    padding-bottom: 35px;
}

.section-heading {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-bottom: 38px;
}

.section-heading h2 {
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    letter-spacing: -1.5px;
}

.section-number {
    color: var(--accent);
    font-size: 0.8rem;
    font-weight: 700;
}

.eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 2px;
    color: var(--accent);
    margin-bottom: 18px;
}

.button {
    min-height: 46px;
    padding: 11px 19px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--text);
    font-size: 0.9rem;
    font-weight: 600;
}

.button-primary {
    background: var(--accent);
    border-color: var(--accent);
    color: #202020;
}

.button-primary:hover {
    background: #D96629;
    border-color: #D96629;
}

.button-secondary {
    background: transparent;
}

.button-secondary:hover {
    color: var(--accent);
    border-color: var(--accent);
}

/* 4. Hero section */
.hero {
    min-height: 570px;
    padding-top: 110px;
    padding-bottom: 85px;
    background: var(--text);
    color: var(--background);
    max-width: 100%;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 50px;
}

.hero-content {
    max-width: 760px;
}

.hero h1 {
    font-size: clamp(2.8rem, 7vw, 5.6rem);
    letter-spacing: -4px;
    margin-bottom: 25px;
}

.hero h1 span {
    color: var(--accent);
    display: block;
}

.hero-description {
    max-width: 610px;
    color: #D5D2CC;
    font-size: 1.05rem;
    margin-bottom: 30px;
}

.hero-actions,
.contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
}

.hero .button-secondary {
    border-color: #777;
}

.hero-note {
    max-width: 220px;
    padding-bottom: 8px;
    color: #D5D2CC;
}

.note-number,
.note-small {
    font-size: 0.75rem;
    color: #AAA59C;
}

.hero-note p {
    margin: 18px 0;
    font-size: 0.95rem;
}

.note-line {
    display: block;
    height: 2px;
    width: 45px;
    background: var(--accent);
}

/* 5. About section */
.about-layout {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 70px;
}

.about-lead {
    font-family: "Space Grotesk", sans-serif;
    font-size: 1.8rem;
    font-weight: 600;
    line-height: 1.35;
}

.about-text p {
    margin-bottom: 17px;
    color: var(--muted);
}

/* 6. Experience cards */
.experience-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
}

.card {
    border: 1px solid var(--border);
    padding: 26px;
    background: transparent;
}

.card:hover {
    border-color: var(--accent);
}

.card-top {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 24px;
}

.tag {
    color: var(--accent);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 1px;
}

.card-year {
    color: var(--muted);
    font-size: 0.75rem;
}

.card h3 {
    font-size: 1.45rem;
    margin-bottom: 6px;
}

.card-role {
    color: var(--accent);
    font-size: 0.85rem;
    margin-bottom: 15px;
}

.card > p:last-child {
    color: var(--muted);
    font-size: 0.93rem;
}

/* 7. Creative portfolio */
.creative-section {
    background: var(--soft);
    max-width: 100%;
    padding-left: max(32px, calc((100% - 1136px) / 2));
    padding-right: max(32px, calc((100% - 1136px) / 2));
}

.creative-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 65px;
    padding-bottom: 30px;
}

.creative-title h3 {
    font-size: clamp(2.7rem, 6vw, 4.5rem);
    letter-spacing: -3px;
}

.creative-title h3 span {
    color: var(--accent);
}

.creative-subtitle {
    margin-top: 15px;
    color: var(--muted);
}

.creative-description p {
    color: #45413D;
    margin-bottom: 18px;
}

.tool-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 25px 0;
}

.tool-list span {
    padding: 7px 12px;
    border: 1px solid #BDA99A;
    font-size: 0.78rem;
    font-weight: 600;
}

.project-note {
    font-size: 0.85rem;
    font-style: italic;
}

/* 8. Leadership and education */
.leadership-list {
    border-top: 1px solid var(--border);
}

.leadership-item {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    padding: 23px 0;
    border-bottom: 1px solid var(--border);
}

.leadership-item h3,
.education-item h3 {
    font-size: 1.15rem;
    margin-bottom: 6px;
}

.leadership-item p,
.education-detail {
    color: var(--muted);
    font-size: 0.9rem;
}

.education-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 25px;
}

.education-item {
    padding: 20px 0;
    border-top: 1px solid var(--border);
}

.education-year {
    display: block;
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 700;
    margin-bottom: 15px;
}

.education-item > p:not(.education-detail) {
    font-size: 0.92rem;
}

/* 9. Skills section */
.skills-layout {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
}

.skills-layout > div {
    padding-top: 18px;
    border-top: 1px solid var(--border);
}

.skills-layout h3 {
    font-size: 1rem;
    margin-bottom: 12px;
}

.skills-layout p {
    font-size: 0.9rem;
    color: var(--muted);
}

/* 10. Resume section */
.resume-download {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    margin-bottom: 25px;
}

.resume-download p {
    color: var(--muted);
    font-size: 0.9rem;
}

.resume-paper {
    max-width: 850px;
    margin: auto;
    padding: 45px 55px;
    background: var(--paper);
    border: 1px solid var(--border);
    color: #202020;
}

.resume-header {
    text-align: center;
    padding-bottom: 16px;
    border-bottom: 2px solid #202020;
}

.resume-header h1 {
    font-size: 1.8rem;
    letter-spacing: 2px;
}

.resume-header p {
    font-size: 0.75rem;
    margin: 8px auto 0;
    overflow-wrap: anywhere;
}

.resume-block {
    margin-top: 20px;
}

.resume-block h2 {
    font-size: 0.85rem;
    border-bottom: 1px solid #999;
    padding-bottom: 5px;
    margin-bottom: 9px;
}

.resume-block p {
    font-size: 0.79rem;
    line-height: 1.45;
    margin-bottom: 4px;
}

/* 11. Contact and footer */
.contact-section {
    max-width: 100%;
    background: var(--text);
    color: var(--background);
    padding-top: 90px;
    padding-bottom: 90px;
    text-align: center;
}

.contact-section h2 {
    font-size: clamp(2.4rem, 6vw, 4.5rem);
    letter-spacing: -2px;
    margin-bottom: 18px;
}

.contact-section > p:not(.eyebrow) {
    color: #D5D2CC;
    margin: 0 auto 30px;
}

.contact-actions {
    justify-content: center;
}

.contact-section .button-secondary {
    border-color: #777;
}

.site-footer {
    max-width: 1200px;
    margin: auto;
    padding: 25px 32px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
}

.site-footer p {
    color: var(--muted);
    font-size: 0.78rem;
}

/* 12. Mobile layout */
@media screen and (max-width: 700px) {
    .navbar {
        padding: 14px 20px;
        flex-wrap: wrap;
        gap: 12px;
    }

    .nav-links {
        order: 3;
        width: 100%;
        overflow-x: auto;
        gap: 18px;
        padding: 8px 0;
    }

    .nav-link {
        white-space: nowrap;
        min-height: 44px;
        display: flex;
        align-items: center;
    }

    .section-container {
        padding-left: 22px;
        padding-right: 22px;
    }

    .hero {
        min-height: auto;
        padding-top: 75px;
        padding-bottom: 60px;
        flex-direction: column;
        align-items: flex-start;
        gap: 45px;
    }

    .hero h1 {
        letter-spacing: -2px;
    }

    .hero-note {
        max-width: 100%;
    }

    .content-section {
        padding-top: 65px;
    }

    .about-layout,
    .creative-layout {
        grid-template-columns: 1fr;
        gap: 25px;
    }

    .experience-grid,
    .education-grid {
        grid-template-columns: 1fr;
    }

    .creative-section {
        padding-left: 22px;
        padding-right: 22px;
    }

    .leadership-item {
        grid-template-columns: 1fr;
        gap: 12px;
    }

    .skills-layout {
        grid-template-columns: 1fr;
        gap: 20px;
    }

    .resume-download {
        flex-direction: column;
        align-items: flex-start;
    }

    .resume-paper {
        padding: 25px 18px;
    }

    .site-footer {
        flex-direction: column;
        align-items: flex-start;
        padding: 25px 22px;
    }

    .contact-section {
        padding-top: 65px;
        padding-bottom: 65px;
    }
}

/* 13. A4 print layout */
@media print {
    @page {
        size: A4;
        margin: 10mm;
    }

    body {
        background: #FFFFFF;
        color: #000000;
        font-family: Arial, sans-serif;
    }

    body * {
        visibility: hidden;
    }

    #resume,
    #resume * {
        visibility: visible;
    }

    #resume {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        max-width: none;
        padding: 0;
        margin: 0;
        background: #FFFFFF;
        color: #000000;
    }

    #resume .no-print {
        display: none;
    }

    .resume-paper {
        width: 100%;
        max-width: none;
        padding: 0;
        margin: 0;
        border: none;
        background: #FFFFFF;
        color: #000000;
        font-family: Arial, sans-serif;
    }

    .resume-header h1 {
        font-size: 17pt;
    }

    .resume-header p {
        font-size: 8pt;
    }

    .resume-block {
        margin-top: 11px;
        break-inside: avoid;
    }

    .resume-block h2 {
        font-size: 9pt;
        color: #000000;
    }

    .resume-block p {
        font-size: 8pt;
        line-height: 1.25;
        margin-bottom: 2px;
        color: #000000;
    }

    a {
        color: #000000;
    }
}
